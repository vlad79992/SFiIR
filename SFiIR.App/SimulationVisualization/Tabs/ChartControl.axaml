<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:avalonia="using:ScottPlot.Avalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SFiIR.App.SimulationVisualization.ChartControl">
    <Border CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{DynamicResource BaseMediumLowBrush}"
            Background="{DynamicResource RegionColorBrush}"
            Padding="5"
            Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" 
                              OffsetX="1" 
                              OffsetY="2" 
                              Color="{DynamicResource ShadowHeavyColor}"/>
        </Border.Effect>

        <avalonia:AvaPlot x:Name="Chart"/>
    </Border>
</UserControl>
