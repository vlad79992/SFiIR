<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:SFiIR.App"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="180"
             x:Class="SFiIR.App.StatisticsCardControl">

    <Border Background="{DynamicResource ListLowBrush}"
            CornerRadius="8"
            Margin="10"
            VerticalAlignment="Top">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" 
                              OffsetX="0" 
                              OffsetY="3" 
                              Color="{DynamicResource ShadowLightColor}" />
        </Border.Effect>

        <Grid ColumnDefinitions="100, 2, *">

            <Grid Grid.Column="0">
                <StackPanel VerticalAlignment="Center">
                    
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Center"
                               Padding="0"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="Light"
                               FontSize="24"
                               Text="id">
                    </TextBlock>

                    <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                               FontWeight="UltraBlack"
                               Padding="0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="48"
                               TextWrapping="Wrap"
                               x:Name="IdText">
                    <TextBlock.Effect>
						<DropShadowEffect BlurRadius="20" 
                              OffsetX="0" 
                              OffsetY="3" 
                              Color="{DynamicResource ShadowColor}" />
                    </TextBlock.Effect>
                    </TextBlock>

                </StackPanel>
            </Grid>

            <Rectangle Grid.Column="1"
                       Fill="{DynamicResource RegionColorBrush}"/>

            <StackPanel Grid.Column="2"
                        Margin="10">
                
                <Grid>
                    <WrapPanel>
                        <TextBlock Text="Время получения заявки:" 
                                   FontSize="14" 
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="RequestArrivalTimeText"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="2,0"/>
                    </WrapPanel>
                </Grid>

                <Grid>
                    <WrapPanel>
                        <TextBlock Text="Время во входной очереди:" 
                                   FontSize="14" 
                                   TextWrapping="Wrap"/> 
                        
                        <TextBlock x:Name="TimeInQueueText" 
                                   FontWeight="Bold" 
                                   FontSize="14" 
                                   TextWrapping="Wrap" 
                                   Margin="2,0"/>
                    </WrapPanel>
                </Grid>
                
                <Grid>
                    <WrapPanel>
                        <TextBlock Text="Время создания процесса:" 
                                   FontSize="14" 
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ProcessArrivalTimeText"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="2,0"/>
                    </WrapPanel>
                </Grid>
                
                <Grid>
                    <WrapPanel>
                        <TextBlock Text="Время в очереди обработки:" 
                                   FontSize="14" 
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ProcessQueueTimeText"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="2,0"/>
                    </WrapPanel>
                </Grid>
                
                <Grid>
                    <WrapPanel>
                        <TextBlock Text="Время обработки процесса:" 
                                   FontSize="14" 
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ProcessExecutionTimeText"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="2,0"/>
                    </WrapPanel>
                </Grid>
                
                <Grid>
                    <WrapPanel>
                        <TextBlock Text="Необходимое время процессора:" 
                                   FontSize="14" 
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="RequiredCpuTimeText"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="2,0"/>
                    </WrapPanel>
                </Grid>
                
                <Grid>
                    <WrapPanel>
                        <TextBlock Text="Необходимое количество памяти:" 
                                   FontSize="14" 
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="RequiredMemoryText"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Margin="2,0"/>
                    </WrapPanel>
                </Grid>

            </StackPanel>

        </Grid>
    </Border>
</UserControl>
