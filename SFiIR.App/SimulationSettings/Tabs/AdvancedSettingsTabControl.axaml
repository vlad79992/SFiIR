<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="SFiIR.App.SimulationSettings.AdvancedSettingsTabControl">
  
    <UserControl.Resources>
        <DropShadowEffect x:Key="MyShadow" 
                          BlurRadius="8" 
                          OffsetX="2" 
                          OffsetY="4" 
                          Color="{DynamicResource ShadowLightColor}" />
    </UserControl.Resources>
    
    <ScrollViewer>
        <StackPanel Margin="0">
            <TextBlock Text="Параметр:" 
                       FontWeight="Bold"
                       Margin="10, 0"/>
            
            <ComboBox x:Name="ParameterCombo" 
                      Margin="10,5,30,10"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="ParameterCombo_SelectionChanged">
                <ComboBoxItem Content="Лямбда прибытия" Tag="ArrivalLambda"/>
                <ComboBoxItem Content="Лямбда памяти" Tag="MemLambda"/>
                <ComboBoxItem Content="Лямбда CPU" Tag="CpuLambda"/>
                <ComboBoxItem Content="Время прибытия" Tag="ArrivalTime"/>
                <ComboBoxItem Content="Время теста" Tag="TestTime"/>
                <ComboBoxItem Content="Память" Tag="MaxMem"/>
                <ComboBoxItem Content="Квант CPU" Tag="CpuQuant"/>
                <ComboBoxItem Content="Seed" Tag="RngSeed"/>
            </ComboBox>
            
            <TextBlock Text="Начальное значение:"
                       Margin="10, 0"/>
            <TextBox x:Name="StartBox"
                     TextChanged="StartBox_TextChanged"
                     Effect="{DynamicResource MyShadow}"
                     Margin="10, 0, 30, 10"/>
            
            <TextBlock Text="Шаг:"
                       Margin="10, 0"/>
            <TextBox x:Name="StepBox"
                     TextChanged="StepBox_TextChanged"
                     Effect="{DynamicResource MyShadow}"
                     Margin="10, 0, 30, 10"/>
            
            <TextBlock Text="Конечное значение:"
                       Margin="10, 0"/>
            <TextBox x:Name="EndBox"
                     TextChanged="EndBox_TextChanged"
                     Effect="{DynamicResource MyShadow}"
                     Margin="10, 0, 30, 10"/>
            
            <!-- -->
            <Border Background="{DynamicResource ListMediumBrush}"
                    Margin="0, 10"
                    Height="1"
                    Opacity="0.5"/>
            
            <Button Grid.Column="0"
                    x:Name="FillButton"
                    Click="FillButton_Click"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Padding="5, 10"
                    Margin="10, 0, 30, 10"
                    CornerRadius="12">
                <TextBlock Text="Заполнить значениями из базовых настроек"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </Button>
            
            <!-- -->
            <TextBlock Margin="10 5" 
                       Text="Лямбда прибытия:"
                       x:Name="ArrivalLambdaText"/> 
            <TextBox x:Name="ArrivalLambdaBox"
                     TextChanged="ArrivalLambdaBox_TextChanged"
                     Effect="{DynamicResource MyShadow}"
                     Margin="10, 0, 30, 10"/>
            
            <TextBlock Margin="10 5"
                       Text="Лямбда памяти:"
                       x:Name="MemLambdaText"/>
            <TextBox x:Name="MemLambdaBox"
                     TextChanged="MemLambdaBox_TextChanged"
                     Effect="{DynamicResource MyShadow}"
                     Margin="10, 0, 30, 10"/>
            
            <TextBlock Margin="10 5"
                       Text="Лямбда CPU:"
                       x:Name="CpuLambdaText"/>
            <TextBox x:Name="CpuLambdaBox"
                     TextChanged="CpuLambdaBox_TextChanged"
                     Effect="{DynamicResource MyShadow}"
                     Margin="10, 0, 30, 10"/>
            
            <TextBlock Margin="10 5"
                       Text="Время прибытия заявок:"
                       x:Name="ArrivalTimeText"/>
            <TextBox x:Name="ArrivalTimeBox"
                     TextChanged="ArrivalTimeBox_TextChanged"
                     Effect="{DynamicResource MyShadow}"
                     Margin="10, 0, 30, 10"/>
            
            <TextBlock Margin="10 5" 
                       Text="Время теста:"
                       x:Name="TestTimeText"/>
            <TextBox x:Name="TestTimeBox"
                     TextChanged="TestTimeBox_TextChanged"
                     Effect="{DynamicResource MyShadow}"
                     Margin="10, 0, 30, 10"/>
            
            <TextBlock Margin="10 5" 
                       Text="Количество памяти:"
                       x:Name="MaxMemText"/>
            <TextBox x:Name="MaxMemBox"
                     TextChanged="MaxMemBox_TextChanged"
                     Effect="{DynamicResource MyShadow}"
                     Margin="10"/>
            
            <TextBlock Margin="10 5" 
                       Text="Время выполнения процесса:"
                       x:Name="CpuQuantText"/>
            <TextBox x:Name="CpuQuantBox"
                     TextChanged="CpuQuantBox_TextChanged"
                     Effect="{DynamicResource MyShadow}"
                     Margin="10, 0, 30, 10"/>
            
            <TextBlock Margin="10 5" 
                       Text="seed:"
                       x:Name="RngSeedText"/>
            <TextBox x:Name="RngSeedBox"
                     TextChanged="RngSeedBox_TextChanged"
                     Effect="{DynamicResource MyShadow}"
                     Margin="10, 0, 30, 10"/>
        
        </StackPanel>
    </ScrollViewer>
</UserControl>
