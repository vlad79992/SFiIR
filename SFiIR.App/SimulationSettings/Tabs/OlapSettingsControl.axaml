<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="SFiIR.App.SimulationSettings.OlapSettingsControl">
  
    <UserControl.Resources>
        <DropShadowEffect x:Key="MyShadow" 
                          BlurRadius="8" 
                          OffsetX="2" 
                          OffsetY="4" 
                          Color="{DynamicResource ShadowLightColor}" />
    </UserControl.Resources>
    
    <ScrollViewer>
        <StackPanel Margin="0">
            <TextBlock Text="Параметр:" 
                       FontWeight="Bold"
                       Margin="10, 0"/>
            
            <ComboBox x:Name="ParameterCombo" 
                      Margin="10,5,30,10"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="ParameterCombo_SelectionChanged">
                <ComboBoxItem Content="Лямбда прибытия" Tag="ArrivalLambda"/>
                <ComboBoxItem Content="Лямбда памяти" Tag="MemLambda"/>
                <ComboBoxItem Content="Лямбда CPU" Tag="CpuLambda"/>
                <ComboBoxItem Content="Время прибытия" Tag="ArrivalTime"/>
                <ComboBoxItem Content="Время теста" Tag="TestTime"/>
                <ComboBoxItem Content="Память" Tag="MaxMem"/>
                <ComboBoxItem Content="Квант CPU" Tag="CpuQuant"/>
            </ComboBox>
            
            <TextBlock x:Name="ParameterErrorText"
                       Foreground="Red"
                       Text="ERROR"
                       Margin="10, 0"
                       IsVisible="False"/>

            <!-- -->
            <Border Background="{DynamicResource ListMediumBrush}"
                    Margin="0, 10"
                    Height="1"
                    Opacity="0.5"/>
            
            <!-- -->
            <TextBlock Margin="10 5" 
                       Text="Лямбда прибытия:"
                       x:Name="ArrivalLambdaText"/> 
            <ComboBox x:Name="ArrivalLambdaCombo" 
                      Margin="10,5,30,10"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="0.1"/>
                <ComboBoxItem Content="0.25"/>
                <ComboBoxItem Content="0.5"/>
                <ComboBoxItem Content="0.75"/>
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="1.5"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="7.5"/>
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="15"/>
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="25"/>
            </ComboBox>
            <TextBlock Margin="10 5" 
                       Text="ERROR"
                       Foreground="Red"
                       IsVisible="False"
                       x:Name="ArrivalLambdaError"/> 

            <TextBlock Margin="10 5"
                       Text="Лямбда памяти:"
                       x:Name="MemLambdaText"/>
            <ComboBox x:Name="MemLambdaCombo" 
                      Margin="10,5,30,10"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="0.01"/>
                <ComboBoxItem Content="0.025"/>
                <ComboBoxItem Content="0.05"/>
                <ComboBoxItem Content="0.075"/>
                <ComboBoxItem Content="0.1"/>
                <ComboBoxItem Content="0.15"/>
                <ComboBoxItem Content="0.2"/>
                <ComboBoxItem Content="0.3"/>
                <ComboBoxItem Content="0.5"/>
                <ComboBoxItem Content="0.75"/>
                <ComboBoxItem Content="1"/>
            </ComboBox>
            <TextBlock Margin="10 5" 
                       Text="ERROR"
                       Foreground="Red"
                       IsVisible="False"
                       x:Name="MemlLambdaError"/> 

            <TextBlock Margin="10 5"
                       Text="Лямбда CPU:"
                       x:Name="CpuLambdaText"/>
            <ComboBox x:Name="CpuLambdaCombo" 
                      Margin="10,5,30,10"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="7"/>
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="15"/>
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="25"/>
                <ComboBoxItem Content="30"/>
                <ComboBoxItem Content="40"/>
                <ComboBoxItem Content="50"/>
            </ComboBox>
            <TextBlock Margin="10 5" 
                       Text="ERROR"
                       Foreground="Red"
                       IsVisible="False"
                       x:Name="CpuLambdaError"/> 

            <TextBlock Margin="10 5"
                       Text="Время прибытия заявок:"
                       x:Name="ArrivalTimeText"/>
            <ComboBox x:Name="ArrivalTimeCombo" 
                      Margin="10,5,30,10"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="100"/>
                <ComboBoxItem Content="250"/>
                <ComboBoxItem Content="500"/>
                <ComboBoxItem Content="1000"/>
                <ComboBoxItem Content="2000"/>
            </ComboBox>
            <TextBlock Margin="10 5" 
                       Text="ERROR"
                       Foreground="Red"
                       IsVisible="False"
                       x:Name="ArrivalTimeError"/> 
            
            <TextBlock Margin="10 5" 
                       Text="Время теста:"
                       x:Name="TestTimeText"/>
            <ComboBox x:Name="TestTimeCombo" 
                      Margin="10,5,30,10"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="200"/>
                <ComboBoxItem Content="500"/>
                <ComboBoxItem Content="1000"/>
                <ComboBoxItem Content="2000"/>
            </ComboBox>
            <TextBlock Margin="10 5" 
                       Text="ERROR"
                       Foreground="Red"
                       IsVisible="False"
                       x:Name="TestTimeError"/> 

            <TextBlock Margin="10 5" 
                       Text="Количество памяти:"
                       x:Name="MaxMemText"/>
            <ComboBox x:Name="MaxMemCombo" 
                      Margin="10,5,30,10"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="25"/>
                <ComboBoxItem Content="50"/>
                <ComboBoxItem Content="75"/>
                <ComboBoxItem Content="100"/>
                <ComboBoxItem Content="125"/>
                <ComboBoxItem Content="150"/>
                <ComboBoxItem Content="175"/>
                <ComboBoxItem Content="200"/>
                <ComboBoxItem Content="225"/>
                <ComboBoxItem Content="250"/>
            </ComboBox>
            <TextBlock Margin="10 5" 
                       Text="ERROR"
                       Foreground="Red"
                       IsVisible="False"
                       x:Name="MaxMemError"/> 
            
            <TextBlock Margin="10 5" 
                       Text="Время выполнения процесса:"
                       x:Name="CpuQuantText"/>
            <ComboBox x:Name="CpuQuantCombo" 
                      Margin="10,5,30,10"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="SelectionChanged">
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="3"/>
                <ComboBoxItem Content="5"/>
                <ComboBoxItem Content="7"/>
                <ComboBoxItem Content="10"/>
                <ComboBoxItem Content="12"/>
                <ComboBoxItem Content="15"/>
                <ComboBoxItem Content="18"/>
                <ComboBoxItem Content="20"/>
                <ComboBoxItem Content="25"/>
            </ComboBox>
           <TextBlock Margin="10 5" 
                       Text="ERROR"
                       Foreground="Red"
                       IsVisible="False"
                       x:Name="CpuQuantError"/> 
        </StackPanel>
    </ScrollViewer>
</UserControl>
